#!/usr/bin/env python3
"""外部通信しない codex exec fixture。"""
import json
import os
from pathlib import Path
import sys

args = sys.argv[1:]
if args == ['--version']:
    print('codex-cli ' + os.environ.get('FAKE_CODEX_VERSION', '0.164.0'))
    sys.exit(0)
if not args or args[0] != 'exec' or args[-1] != '-':
    sys.exit('unsupported fake codex arguments')
if args[1:2] == ['resume'] and (len(args) < 3 or args[2].startswith('-')):
    sys.exit('resume requires a thread')
prompt = sys.stdin.read()
if os.environ.get('FAKE_CODEX_CALLS'):
    with open(os.environ['FAKE_CODEX_CALLS'], 'a') as out:
        out.write(json.dumps({'argv': args, 'input': prompt, 'cwd': os.getcwd()}) + '\n')
scenario = os.environ.get('FAKE_CODEX_SCENARIO', 'done')
thread = args[2] if args[1:2] == ['resume'] else 'thread-123'
events = [
    {'type': 'thread.started', 'thread_id': thread},
    {'type': 'turn.started'},
    {'type': 'item.started', 'item': {'type': 'command_execution', 'command': 'fake test'}},
    {'type': 'item.completed', 'item': {'type': 'command_execution', 'exit_code': 0,
                                       'status': 'completed', 'aggregated_output': 'ok'}},
    {'type': 'item.completed', 'item': {'type': 'file_change', 'status': 'completed',
                                       'changes': [{'path': 'tracked.txt', 'kind': 'update'}]}},
    {'type': 'item.completed', 'item': {'type': 'agent_message', 'text': 'fixture 完了'}},
    {'type': 'turn.completed', 'usage': {'input_tokens': 42, 'cached_input_tokens': 0,
                                       'output_tokens': 7, 'reasoning_output_tokens': 0}},
]
for event in events:
    print(json.dumps(event), flush=True)
print('not-json', flush=True)
print('{"type":"future"}', flush=True)
if scenario == 'fail':
    print('fake codex failed', file=sys.stderr)
    sys.exit(1)
if scenario != 'missing':
    done = {'status': 'blocked' if scenario == 'blocked' else 'done', 'summary': 'fixture',
            'changed_files': [], 'tests': 'fixture test', 'risks': ''}
    Path(args[args.index('-o') + 1]).write_text(json.dumps(done))
if scenario == 'nonzero_done':
    print('failed after DONE', file=sys.stderr)
    sys.exit(1)
